# API server
PORT=5000

# PostgreSQL connection used by Drizzle
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_goods

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# Admin-only authentication (use a long random secret in production)
ADMIN_EMAIL=admin@homegoodshub.com
ADMIN_PASSWORD=change-this-in-a-secret-manager
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
